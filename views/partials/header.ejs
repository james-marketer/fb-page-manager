<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Facebook Page Manager</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
<% if (typeof loggedIn === "undefined" || loggedIn !== false) { %>
<nav>
  <span class="brand">Page Manager</span>
  <a href="/pages">Pages</a>
  <a href="/posts">All Posts</a>
  <form method="POST" action="/logout"><button type="submit" class="link">Log out</button></form>
</nav>
<% } %>
<main>
<% if (typeof query !== "undefined" && query.msg) { %>
  <div class="flash <%= query.type === 'error' ? 'error' : 'success' %>"><%= query.msg %></div>
<% } %>
