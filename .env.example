# One Facebook App receives webhooks for every page you add below.
VERIFY_TOKEN=pick_any_random_string_you_want
APP_SECRET=paste_your_facebook_app_secret_here

# Locks the dashboard behind a single shared password (it holds every
# connected page's access token, so don't leave this blank).
ADMIN_PASSWORD=pick_a_strong_password

# Signs the login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Encrypts stored page access tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

PORT=3100

# Optional: absolute path to a persistent volume on your host. Defaults to ./data
# DATA_DIR=

# For the AI booking assistant. Get your own key at console.anthropic.com --
# without it, pages with booking enabled will tell customers it's
# temporarily unavailable instead of crashing.
ANTHROPIC_API_KEY=
# Defaults to Haiku (cheapest capable model) if left blank -- matters once
# you're paying for this across several resold clients.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
